#!/bin/sh
#
# @name HIL lc_62
#
# @type Standard VTOL
# @class VTOL
#
# HITL twin of 4101_gz_lc_62 (SITL): identical control allocation and
# tuning, with the simulator-side outputs replaced by HIL channels.
#
# The channel layout is the contract with RealGazebo's gz-hitl-bridge,
# which drives gz from HIL_ACTUATOR_CONTROLS. The bridge takes the
# leading channels as motors and the rest as control surfaces, and the
# manager derives both counts from the model's own RealGazebo plugin
# block, so this file must mirror lc_62.sdf.jinja's declaration order:
#
#   ch 1..8   motors   <motorJoint>   rotor_0..5, left/right_rotor_puller
#   ch 9..13  servos   <moveableLink> left/right_ail, left/right_elevator,
#                                     rudder  -> servo_0..4 topics
#

. ${R}etc/init.d/rc.vtol_defaults

param set SYS_HITL 1

param set UAVCAN_ENABLE 0

# no real battery on the bench
param set-default CBRK_SUPPLY_CHK 894281

param set-default FD_ACT_EN 0
param set-default FD_ACT_MOT_TOUT 500
param set-default FD_ESCS_EN 0

param set-default CA_METHOD 1
param set-default CA_AIRFRAME 2

param set-default CA_ROTOR_COUNT 8
param set-default CA_ROTOR0_PX 0.0000
param set-default CA_ROTOR0_PY 0.7475
param set-default CA_ROTOR0_KM -0.06

param set-default CA_ROTOR1_PX 0.0000
param set-default CA_ROTOR1_PY -0.7475
param set-default CA_ROTOR1_KM 0.06

param set-default CA_ROTOR2_PX 1.0300
param set-default CA_ROTOR2_PY -0.7475
param set-default CA_ROTOR2_KM -0.06

param set-default CA_ROTOR3_PX -1.0300
param set-default CA_ROTOR3_PY 0.7475
param set-default CA_ROTOR3_KM 0.06

param set-default CA_ROTOR4_PX 1.0300
param set-default CA_ROTOR4_PY 0.7475
param set-default CA_ROTOR4_KM 0.06

param set-default CA_ROTOR5_PX -1.0300
param set-default CA_ROTOR5_PY -0.7475
param set-default CA_ROTOR5_KM -0.0500

param set-default CA_ROTOR6_AX 1.0000
param set-default CA_ROTOR6_AZ 0.0000
param set-default CA_ROTOR6_PX -0.4900
param set-default CA_ROTOR6_PY -1.1400

param set-default CA_ROTOR7_AX 1.0000
param set-default CA_ROTOR7_AZ 0.0000
param set-default CA_ROTOR7_PX -0.4900
param set-default CA_ROTOR7_PY 1.1400

param set-default CA_SV_CS_COUNT 5
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS2_TYPE 3
param set-default CA_SV_CS2_TRQ_P 1.0
param set-default CA_SV_CS3_TYPE 3
param set-default CA_SV_CS3_TRQ_P 1.0
param set-default CA_SV_CS4_TYPE 4
param set-default CA_SV_CS4_TRQ_Y 1.0

# HIL channels: motors first (101..), then control surfaces (201..).
# The bridge relies on this order; see the header comment.
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104
param set-default HIL_ACT_FUNC5 105
param set-default HIL_ACT_FUNC6 106
param set-default HIL_ACT_FUNC7 107
param set-default HIL_ACT_FUNC8 108
param set-default HIL_ACT_FUNC9 201
param set-default HIL_ACT_FUNC10 202
param set-default HIL_ACT_FUNC11 203
param set-default HIL_ACT_FUNC12 204
param set-default HIL_ACT_FUNC13 205

param set-default NPFG_PERIOD 12

param set-default FW_PR_FF 0.5000
param set-default FW_PR_P 0.2000
param set-default FW_PSP_OFF 3.0000
param set-default FW_P_LIM_MIN -10.0000
param set-default FW_RR_FF 0.5000
param set-default FW_RR_P 0.2000
param set-default FW_THR_TRIM 0.300
param set-default FW_THR_MAX 1.0000
param set-default FW_THR_MIN 0.0500
param set-default FW_T_CLMB_MAX 5.0000
param set-default FW_T_SINK_MAX 5.0000
param set-default FW_T_SINK_MIN 2.0000

param set-default MC_AIRMODE 1
param set-default MC_ROLLRATE_P 0.2500
param set-default MC_YAW_P 1.6

param set-default MIS_TAKEOFF_ALT 10
param set-default MPC_XY_P 0.9500
param set-default MPC_XY_VEL_P_ACC 1.0000
param set-default MPC_XY_VEL_I_ACC 0.2000
param set-default MPC_XY_VEL_D_ACC 0.4000
param set-default NAV_ACC_RAD 50.0000
param set-default VT_FWD_THRUST_EN 0
param set-default VT_F_TRANS_THR 0.3000
param set-default VT_PSHER_SLEW 3
param set-default VT_TYPE 2

param set-default FW_AIRSPD_MAX 40.0000
param set-default FW_AIRSPD_TRIM 25.0000
param set-default FW_MAN_P_MAX 15.0000
param set-default FW_MAN_R_MAX 30.0000
param set-default FW_P_LIM_MAX 15.0000
param set-default FW_P_RMAX_NEG 30.0000
param set-default FW_P_RMAX_POS 30.0000
param set-default FW_P_TC 0.2000
param set-default FW_R_LIM 30.0000
param set-default FW_R_RMAX 50.0000
param set-default FW_THR_IDLE 0.3000
param set-default FW_THR_SLEW_MAX 0.6000
param set-default FW_T_HRATE_FF 0.3000
param set-default FW_WR_IMAX 1.0000
param set-default FW_YR_P 0.1500

param set-default IMU_DGYRO_CUTOFF 30.0000

param set-default MC_PITCHRATE_D 0.0080
param set-default MC_PITCHRATE_I 0.0500
param set-default MC_PITCHRATE_MAX 40.0000
param set-default MC_PITCHRATE_P 0.2500
param set-default MC_PITCH_P 4.0000
param set-default MC_ROLLRATE_D 0.0060
param set-default MC_ROLLRATE_I 0.0500
param set-default MC_ROLLRATE_MAX 70.0000
param set-default MC_ROLL_P 3.0000
param set-default MC_YAWRATE_D 0.0080
param set-default MC_YAWRATE_I 0.0000
param set-default MC_YAWRATE_MAX 25.0000
param set-default MC_YAWRATE_P 1.5000

param set-default MIS_DIST_1WP 10000.0000

param set-default MPC_LAND_SPEED 1.0000
param set-default MPC_MAN_Y_MAX 20.0000
param set-default MPC_THR_HOVER 0.5500
param set-default MPC_TKO_SPEED 1.0000
param set-default MPC_VEL_MANUAL 3.0000
param set-default MPC_XY_CRUISE 3.0000
param set-default MPC_XY_VEL_MAX 5.0000
param set-default MPC_YAWRAUTO_MAX 30.0000
param set-default MPC_YAW_MODE 0
param set-default MPC_Z_VEL_MAX_DN 2.5000

param set-default NAV_LOITER_RAD 400.0000
param set-default NAV_MC_ALT_RAD 0.8000

param set-default RTL_DESCEND_ALT 10.0000

param set-default VT_ARSP_TRANS 25.0000
param set-default VT_B_DEC_I 0.0000
param set-default VT_QC_T_ALT_LOSS 60.0000
param set-default VT_TRANS_TIMEOUT 60.0000
param set-default VT_FW_DIFTHR_EN 0
param set-default VT_FW_DIFTHR_S_R 0
param set-default VT_FW_DIFTHR_S_P 0
param set-default VT_FW_DIFTHR_S_Y 0

# bench HITL has no RC receiver
param set-default COM_RCL_EXCEPT 31
param set-default COM_RC_IN_MODE 4
param set-default NAV_DLL_ACT 0
